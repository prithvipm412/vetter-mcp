# Copy to .env and adjust as needed. Real environment variables always take
# precedence over values in this file (see vetter/config.py).

# SQLite database file used by the backend and CLI.
VETTER_DB_PATH=vetter.db

# Approval/fingerprint store.
VETTER_LOCK_PATH=vetter-lock.json

# Comma-separated list of origins the API will accept browser requests from.
VETTER_CORS_ORIGINS=http://localhost:5173

# Port the FastAPI backend listens on (vetter serve / run_backend.sh).
VETTER_BACKEND_PORT=8000
